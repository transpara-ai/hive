[Unit]
Description=Civilization Factory v1 run-forever stack
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=FACTORY_V1_RUNTIME_ROOT=/home/transpara/transpara-ai/runtime/civilization-dark-factory-v1
Environment=FACTORY_V1_CONFIG_PATH=/home/transpara/transpara-ai/runtime/civilization-dark-factory-v1/config/runtime.env
EnvironmentFile=-/home/transpara/transpara-ai/runtime/civilization-dark-factory-v1/config/supervisor-launch.env
WorkingDirectory=/home/transpara/transpara-ai/repos/hive
ExecStart=/home/transpara/transpara-ai/repos/hive/scripts/factory-v1/supervisor.sh run
Restart=on-failure
RestartSec=3s
TimeoutStartSec=120s
TimeoutStopSec=60s
KillMode=control-group

[Install]
WantedBy=default.target
